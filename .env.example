# Copy to .env and fill in. Never commit the real .env.

# Neon PostgreSQL. Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (same, without "-pooler"): used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Neon env pull may also provide DATABASE_URL_POOLED and DATABASE_URL_UNPOOLED.
# The app prefers the former; Prisma migrations accept the latter as DIRECT_URL's alternative.

# Better Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# The public URL of the app: https://your-domain in production. Locally any localhost port is accepted,
# so this can stay as http://localhost:3000 even when `npm run dev` picks another free port.
BETTER_AUTH_URL="http://localhost:3000"

# Optional: sample aggregate client sync metrics (10% of successes, all failures).
NEXT_PUBLIC_SYNC_TELEMETRY="0"
NEXT_PUBLIC_NEON_REALTIME_SYNC="0"
# Optional: 0–1 share of successful server requests to log; errors are always logged.
TELEMETRY_SUCCESS_SAMPLE_RATE="0.1"

# Optional Neon service diagnostics. Generate a strong STOCKWISE_ORIGIN_SECRET
# before `neon deploy --env .env`; the CLI pulls NEON_FUNCTION_STOCKWISE_BASE_URL.
# STOCKWISE_FUNCTION_URL can override the pulled URL when needed.
S3_BUCKET="uploads"
STOCKWISE_FUNCTION_URL=""
