# Copy to .env and fill in. Never commit the real .env.

# Neon PostgreSQL. Pooled connection (host contains "-pooler"): used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct connection (same, without "-pooler"): used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Better Auth. Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# The public URL of the app (http://localhost:3100 locally, https://your-domain in production).
BETTER_AUTH_URL="http://localhost:3100"
